<Window x:Class="Kestrel.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kestrel Studio" Height="860" Width="1400" MinWidth="1000" MinHeight="600"
        Background="{StaticResource Bg}" FontFamily="Segoe UI"
        AllowDrop="True" Drop="OnDrop" Closing="OnClosing">
  <Grid Margin="6">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="270"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="330"/>
    </Grid.ColumnDefinitions>

    <!-- ============================================================ left: model + sessions -->
    <DockPanel Grid.Column="0">
      <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="MODEL" Style="{StaticResource Lbl}" Margin="0,0,0,4"/>
          <TextBlock x:Name="ModelName" Text="No model loaded" FontSize="17" FontWeight="SemiBold"
                     TextWrapping="Wrap"/>
          <TextBlock x:Name="ModelInfo" Foreground="{StaticResource Muted}" FontSize="11"
                     TextWrapping="Wrap" Margin="0,4,0,8"
                     Text="Import a Kestrel .gguf (or drop one on this window)."/>
          <ComboBox x:Name="ModelList" DisplayMemberPath="Label" Margin="0,0,0,8"
                    SelectionChanged="OnModelPicked"/>
          <ProgressBar x:Name="LoadBar" Height="4" Visibility="Collapsed" Margin="0,0,0,8"
                       Foreground="{StaticResource Accent}" Background="{StaticResource Raised}"
                       BorderThickness="0" Maximum="1"/>
          <WrapPanel>
            <Button Content="Import .gguf…" Click="OnImport"/>
            <Button Content="Open folder" Click="OnOpenFolder"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="SESSIONS" Style="{StaticResource Lbl}" Margin="0,0,0,6"/>
          <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource Muted}" FontSize="11"
                     TextWrapping="Wrap" Margin="0,0,0,8"
                     Text="A saved session stores the model's exact internal state, so it resumes instantly without re-reading the chat."/>
          <WrapPanel DockPanel.Dock="Top">
            <Button x:Name="BtnNew" Content="New chat" Click="OnNewChat"/>
            <Button x:Name="BtnSave" Content="Save" Click="OnSaveSession"/>
          </WrapPanel>
          <ListBox x:Name="SessionList" Background="Transparent" BorderThickness="0"
                   Foreground="{StaticResource Text}" MouseDoubleClick="OnOpenSession"
                   ToolTip="Double-click to resume"/>
        </DockPanel>
      </Border>
    </DockPanel>

    <!-- ============================================================ center: chat -->
    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="16,12,16,8">
          <Border x:Name="StateDot" Width="10" Height="10" CornerRadius="5" Background="#555B6B"
                  VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock x:Name="StatusText" Text="idle" Foreground="{StaticResource Muted}"
                     VerticalAlignment="Center"/>
          <TextBlock x:Name="SpeedText" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"
                     VerticalAlignment="Center"/>
        </DockPanel>

        <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,0">
          <ItemsControl x:Name="Messages">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{Binding Bubble}" CornerRadius="10" Padding="12,9" Margin="0,5"
                        MaxWidth="720" HorizontalAlignment="{Binding Align}">
                  <StackPanel>
                    <TextBlock Text="{Binding Header}" FontSize="11" Foreground="{StaticResource Muted}"
                               Margin="0,0,0,3"/>
                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             FontFamily="Segoe UI" FontSize="14"/>
                    <TextBlock Text="{Binding Footer}" FontSize="10" Foreground="{StaticResource Muted}"
                               Margin="0,4,0,0" TextWrapping="Wrap">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFooter}" Value="True">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="16,8,16,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="Input" MinHeight="44" MaxHeight="180" AcceptsReturn="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" PreviewKeyDown="OnInputKey"
                   ToolTip="Enter sends, Shift+Enter adds a line"/>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <Button x:Name="BtnSend" Content="Send" Style="{StaticResource AccentButton}" Click="OnSend"
                    Width="80"/>
            <Button x:Name="BtnStop" Content="Stop" Click="OnStop" Width="80" IsEnabled="False"/>
          </StackPanel>
        </Grid>

        <DockPanel Grid.Row="3" Margin="16,0,16,10">
          <TextBlock x:Name="CtxText" Foreground="{StaticResource Muted}" FontSize="11" Width="190"/>
          <ProgressBar x:Name="CtxBar" Height="4" Maximum="1" VerticalAlignment="Center"
                       Foreground="{StaticResource Accent}" Background="{StaticResource Raised}" BorderThickness="0"/>
        </DockPanel>
      </Grid>
    </Border>

    <!-- ============================================================ right: controls -->
    <TabControl Grid.Column="2" Background="Transparent" BorderThickness="0" Margin="6">
      <TabItem Header="Think">
        <Border Style="{StaticResource Card}" Margin="0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Thinking depth (looped core)" Style="{StaticResource H}"/>
              <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                         Text="Kestrel re-runs its core blocks R times per token. More passes = more computation on every word, at the same size. Changing it re-reads the chat."/>
              <DockPanel Margin="0,8,0,0">
                <TextBlock x:Name="LoopsText" DockPanel.Dock="Right" Width="90" TextAlignment="Right"
                           FontWeight="SemiBold"/>
                <Slider x:Name="LoopsSlider" Minimum="1" Maximum="3" TickFrequency="1"
                        ValueChanged="OnLoopsChanged"/>
              </DockPanel>

              <TextBlock Text="Sampling" Style="{StaticResource H}" Margin="0,18,0,0"/>
              <TextBlock x:Name="TempText" Style="{StaticResource Lbl}"/>
              <Slider x:Name="TempSlider" Minimum="0" Maximum="1.5" TickFrequency="0.05" ValueChanged="OnSampling"/>
              <TextBlock x:Name="TopPText" Style="{StaticResource Lbl}"/>
              <Slider x:Name="TopPSlider" Minimum="0.5" Maximum="1" TickFrequency="0.01" ValueChanged="OnSampling"/>
              <TextBlock x:Name="TopKText" Style="{StaticResource Lbl}"/>
              <Slider x:Name="TopKSlider" Minimum="0" Maximum="100" TickFrequency="5" ValueChanged="OnSampling"/>
              <TextBlock x:Name="RepText" Style="{StaticResource Lbl}"/>
              <Slider x:Name="RepSlider" Minimum="1" Maximum="1.5" TickFrequency="0.05" ValueChanged="OnSampling"/>
              <TextBlock x:Name="MaxText" Style="{StaticResource Lbl}"/>
              <Slider x:Name="MaxSlider" Minimum="32" Maximum="1024" TickFrequency="32" ValueChanged="OnSampling"/>

              <TextBlock Text="System prompt" Style="{StaticResource H}" Margin="0,18,0,0"/>
              <TextBox x:Name="SystemBox" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"/>
              <Button Content="Apply (re-reads chat)" Click="OnApplySystem" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </TabItem>

      <TabItem Header="Memory">
        <Border Style="{StaticResource Card}" Margin="0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="Roost memory" Style="{StaticResource H}"/>
              <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                         Text="Teach Kestrel facts. Each message recalls the most relevant ones, matched in the model's own representation space. The same episodic.jsonl can be consolidated into the model's memory slots with the Roost 'sleep' job on Colab."/>
              <CheckBox x:Name="UseMemory" Content="Recall memories while chatting" Click="OnUseMemory"/>
              <TextBox x:Name="TeachBox" Margin="0,10,0,0" MinHeight="54" AcceptsReturn="True" TextWrapping="Wrap"
                       ToolTip="One fact per line"/>
              <Button Content="Teach" Click="OnTeach" HorizontalAlignment="Left" Margin="0,8,0,0"
                      Style="{StaticResource AccentButton}"/>
              <TextBlock x:Name="RecalledText" Foreground="{StaticResource Accent}" FontSize="11"
                         TextWrapping="Wrap" Margin="0,4,0,8"/>
              <TextBlock x:Name="MemoryCount" Style="{StaticResource Lbl}"/>
            </StackPanel>
            <ListBox x:Name="FactList" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource Text}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,2" Width="270">
                    <Button DockPanel.Dock="Right" Content="✕" Padding="6,2" Margin="4,0,0,0"
                            Click="OnForget" Tag="{Binding}"/>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12"/>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </TabItem>

      <TabItem Header="Inside">
        <Border Style="{StaticResource Card}" Margin="0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Product-key memory" Style="{StaticResource H}"/>
              <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                         Text="Each square is one memory slot; it lights up when a token reads it. Kestrel picks 8 of 16,384 slots per token at each site, and these slots are where Roost writes new knowledge."/>
              <ItemsControl x:Name="PkmPanels" Margin="0,8,0,0"/>
              <TextBlock Text="Live state" Style="{StaticResource H}" Margin="0,14,0,0"/>
              <TextBlock x:Name="StateInfo" Foreground="{StaticResource Muted}" FontSize="12"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
